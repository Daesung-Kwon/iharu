{
  "expo": {
    "name": "i하루",
    "slug": "daily-schedule-app",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "fonts": [
      "./assets/fonts/BMJUA_ttf.ttf"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailyschedule.app",
      "buildNumber": "8",
      "requireFullScreen": false,
      "deviceFamily": [
        "ipad"
      ],
      "infoPlist": {
        "NSUserTrackingUsageDescription": "이 앱은 맞춤형 광고를 위한 추적을 사용하지 않습니다. 표시되는 광고는 비맞춤형입니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.iharu.app",
      "tabletOnly": true,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "deviceFamily": [
              2
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FFF8E7",
          "sounds": []
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9978285135642181~1318901506",
          "iosAppId": "ca-app-pub-9978285135642181~7551710314",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "이 앱은 맞춤형 광고를 위한 추적을 사용하지 않습니다. 표시되는 광고는 비맞춤형입니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "31a89f46-760d-491d-8ba6-a3ffda29ad8d"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "ds.kwon"
  }
}